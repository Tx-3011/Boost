{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Boost",
  "version": "0.1.0",
  "identifier": "dev.boost.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:desktop",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Boost", "width": 850, "height": 730, "resizable": true }],
    "security": { "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'" }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": ["binaries/dispatch.exe"],
    "publisher": "Boost",
    "category": "Utility",
    "shortDescription": "Use more than one connection for a download.",
    "longDescription": "Boost balances one Windows application's IPv4 TCP downloads across selected network adapters. It does not guarantee a speed increase or accelerate UDP/QUIC traffic.",
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
